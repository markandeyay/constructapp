# Application
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Database / local services
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=plasmid
POSTGRES_PASSWORD=plasmid
POSTGRES_DB=plasmid_design
DATABASE_URL=postgresql://plasmid:plasmid@localhost:5432/plasmid_design
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_PORT=9000
OBJECT_STORE_CONSOLE_PORT=9001
OBJECT_STORE_BUCKET=plasmid-design-local
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
VECTOR_DB_URL=postgresql://plasmid:plasmid@localhost:5432/plasmid_design

# External data access
# NCBI requires a real contact email for Entrez/E-utilities requests.
NCBI_EMAIL=researcher@example.com
# Optional: an NCBI API key raises the default E-utilities limit from 3 req/sec to 10 req/sec.
NCBI_API_KEY=
NCBI_TOOL=construct-plasmid-design
NCBI_GENBANK_QUERY=plasmid[Title] AND "complete sequence"[Title] AND 1000:50000[SLEN] AND biomol_genomic[PROP] AND genbank[FILTER] NOT gbdiv_con[PROP] NOT wgs[FILTER] NOT tsa[FILTER]
NCBI_REQUESTS_PER_SECOND=3.0
NCBI_MAX_RETRIES=3
NCBI_BACKOFF_SECONDS=2.0
NCBI_PAGE_SIZE=100
ADDGENE_API_BASE_URL=https://api.developers.addgene.org/
ADDGENE_API_KEY=
ADDGENE_API_TOKEN=
ADDGENE_DATA_LICENSE_ACCEPTED=false
ADDGENE_MIN_INTERVAL_SECONDS=1.0
ADDGENE_MAX_RETRIES=3
ADDGENE_BACKOFF_SECONDS=2.0
ADDGENE_PAGE_SIZE=100

# Model providers
# GOOGLE_API_KEY enables Gemini 2.5 Flash for plasmid intent parsing and grounded
# recommendations in the local app. Leave it blank and the app falls back to
# FakeIntentParser and TemplateRecommendationGenerator: retrieval, validation, all
# four capabilities, the provenance gate and every export still work, the plasmid
# chat just parses intent by rule instead of by model. Nothing else reads it.
GOOGLE_API_KEY=
# LLM_PROVIDER and LLM_API_KEY are read by no code in this build. Kept because
# removing a name from this file silently breaks anyone whose .env sets it.
LLM_PROVIDER=
LLM_API_KEY=
# Phase 1 embedding foundation defaults to NeuML/pubmedbert-base-embeddings at a pinned revision.
# Set EMBEDDING_FAKE=true for network-free smoke runs and EMBEDDING_LOCAL_FILES_ONLY=true after the model is cached.
EMBEDDING_MODEL_NAME=NeuML/pubmedbert-base-embeddings
EMBEDDING_MODEL_REVISION=b79526d6ef3645e0df4530322e266f24c829f5ef
EMBEDDING_HF_CACHE_DIR=
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_FAKE=false
DNA_MODEL_NAME=
MODEL_ARTIFACT_URI=

# Experiment tracking
MLFLOW_TRACKING_URI=

# Synthesis handoff providers
TWIST_API_KEY=
IDT_API_KEY=
GENSCRIPT_API_KEY=
