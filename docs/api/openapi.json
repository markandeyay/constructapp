          "end": {
            "exclusiveMinimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          },
          "strand": {
            "enum": [
              -1,
              0,
              1
            ],
            "title": "Strand",
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/FeatureType"
          }
        },
        "required": [
          "start",
          "end",
          "type",
          "strand",
          "name",
          "confidence"
        ],
        "title": "AnnotatedFeature",
        "type": "object"
      },
      "AnnotatedSequence": {
